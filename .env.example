# =============================================================================
# Sportss Colombia - configuración de ejemplo
# Copia este archivo como .env y ajusta los valores antes de ejecutar.
# Nunca subas el archivo .env real al repositorio.
# =============================================================================

# --- Aplicación -------------------------------------------------------------
APP_NAME=Sportss Colombia
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=America/Bogota

# Secretos de la aplicación. Genera valores largos y aleatorios en producción.
# Ejemplo (PowerShell): [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
APP_SECRET=cambia-este-secreto-de-desarrollo-por-uno-largo-y-aleatorio
JWT_SECRET=cambia-este-secreto-jwt-de-desarrollo-por-uno-largo-y-aleatorio

# Sesión
COOKIE_NAME=sportss_token
# true en producción (HTTPS). En local con HTTP debe ser false.
COOKIE_SECURE=false

# --- Base de datos ----------------------------------------------------------
SQLITE_PATH=storage/sportss.db

# --- Redis (caché y bloqueos de reserva) ------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Mercado Pago -----------------------------------------------------------
# Si MP_ACCESS_TOKEN está vacío, la aplicación usa el checkout simulado local.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
# true para usar sandbox_init_point en pruebas.
MP_SANDBOX=true

# --- Reglas de negocio ------------------------------------------------------
# Comisión de la plataforma sobre cada reserva (0 a 100).
COMMISSION_PERCENT=10
# Minutos que dura el bloqueo Redis de un horario mientras se paga.
BOOKING_LOCK_MINUTES=10
# Minutos antes de expirar una reserva pendiente de pago.
PENDING_EXPIRATION_MINUTES=10
# Horas mínimas antes del inicio para que el jugador pueda cancelar.
# 0 desactiva la restricción.
CANCELLATION_HOURS=24
# Tamaño máximo por imagen subida (1 a 20 MB).
UPLOAD_MAX_MB=5

# --- Rutas de almacenamiento ------------------------------------------------
STORAGE_DIR=storage
INVOICE_DIR=storage/invoices
UPLOAD_DIR=web/static/uploads
TEMPLATE_DIR=web/templates
STATIC_DIR=web/static
